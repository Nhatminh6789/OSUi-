rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myName() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.name; }

    // Tên người chơi -> uid (mỗi tên chỉ tạo được 1 lần)
    match /usernames/{n} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && n.matches('^[a-z0-9_.-]{3,16}$');
    }

    // Hồ sơ công khai
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','nameLower','pp_std','pp_mania','plays','created'])
                    && request.resource.data.name is string
                    && request.resource.data.name.matches('^[A-Za-z0-9_.-]{3,16}$')
                    && request.resource.data.nameLower == request.resource.data.name.lower()
                    && request.resource.data.pp_std == 0 && request.resource.data.pp_mania == 0
                    && request.resource.data.plays == 0
                    && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.nameLower)).data.uid == uid;
      allow update: if verified() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pp_std','pp_mania','plays','avatar'])
                    && (!('avatar' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000
                            && (request.resource.data.avatar == '' || request.resource.data.avatar.matches('^data:image/(jpeg|png|webp);base64,.*'))))
                    && request.resource.data.pp_std >= 0 && request.resource.data.pp_std <= 30000
                    && request.resource.data.pp_mania >= 0 && request.resource.data.pp_mania <= 30000
                    && request.resource.data.plays >= resource.data.plays
                    && request.resource.data.plays <= resource.data.plays + 1;
    }

    // Kỷ lục tốt nhất của mỗi người trên mỗi map + chế độ
    match /scores/{id} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == myName()
        && id == request.auth.uid + '_' + request.resource.data.map + '_' + string(request.resource.data.mode)
        && request.resource.data.mode in [0, 1]
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2000000000
        && request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 1
        && request.resource.data.pp is number && request.resource.data.pp >= 0 && request.resource.data.pp <= 3000
        && (request.method == 'create' || request.resource.data.score > resource.data.score);
      allow delete: if false;
    }

    // Replay của kỷ lục tốt nhất (nén gzip+base64 trong trường d). Ai cũng xem được; chỉ chủ điểm ghi được,
    // và điểm trong replay phải khớp với tài liệu scores tương ứng (ghi scores trước, replays sau).
    match /replays/{id} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.keys().hasOnly(['uid','map','mode','score','mods','cv','d','date'])
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.map + '_' + string(request.resource.data.mode)
        && request.resource.data.mode in [0, 1]
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000
        && request.resource.data.mods is list && request.resource.data.mods.size() <= 10
        && request.resource.data.score is int
        && get(/databases/$(db)/documents/scores/$(id)).data.score == request.resource.data.score;
      allow delete: if false;
    }

    // Lịch sử chơi (chỉ thêm, không sửa/xóa)
    match /plays/{id} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == myName()
        && request.resource.data.mode in [0, 1]
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2000000000
        && request.resource.data.pp is number && request.resource.data.pp >= 0 && request.resource.data.pp <= 3000;
      allow update, delete: if false;
    }

    // ============ KẾT BẠN ============
    // Lời mời: id = <uidGửi>_<uidNhận>
    match /friendReqs/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['from','fromName','to','toName','t'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromName == myName()
        && request.resource.data.toName is string
        && exists(/databases/$(db)/documents/users/$(request.resource.data.to))
        && get(/databases/$(db)/documents/users/$(request.resource.data.to)).data.name == request.resource.data.toName;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // Bạn bè: id = id của lời mời đã được chấp nhận (<người gửi>_<người nhận>)
    match /friends/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['a','b','aName','bName','members','since'])
        && request.resource.data.b == request.auth.uid
        && id == request.resource.data.a + '_' + request.resource.data.b
        && request.resource.data.members == [request.resource.data.a, request.resource.data.b]
        && request.resource.data.bName == myName()
        && exists(/databases/$(db)/documents/friendReqs/$(id));
      allow delete: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow update: if false;
    }

    // ============ MULTIPLAYER (alpha) ============
    function roomOf(rid) { return get(/databases/$(db)/documents/rooms/$(rid)).data; }
    function isMember(rid) { return verified() && exists(/databases/$(db)/documents/rooms/$(rid)/players/$(request.auth.uid)); }

    match /rooms/{rid} {
      allow read: if signedIn();
      allow create: if verified()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && request.resource.data.state == 'lobby'
        && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 8
        && request.resource.data.get('vs', 0) in [0, 1]
        && request.resource.data.get('win', 'score') in ['score', 'acc', 'combo']
        && request.resource.data.get('qm', 'host') in ['host', 'all'];
      allow update: if verified() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.state in ['lobby', 'countdown', 'playing']
        && request.resource.data.mode in [0, 1]
        && request.resource.data.mods.size() <= 6
        && request.resource.data.mods.hasOnly(['EZ','HT','HR','HD','DT','FL','NF','SD','PF','SO'])
        && request.resource.data.get('vs', 0) in [0, 1]
        && request.resource.data.get('win', 'score') in ['score', 'acc', 'combo']
        && request.resource.data.get('qm', 'host') in ['host', 'all'];
      allow delete: if verified() && resource.data.hostUid == request.auth.uid;

      // Mật khẩu phòng: chỉ lưu hash, không ai đọc được (rules vẫn dùng get() để kiểm tra khi vào phòng)
      match /secret/{d} {
        allow read: if false;
        allow create: if verified() && roomOf(rid).hostUid == request.auth.uid;
        allow delete: if verified() && roomOf(rid).hostUid == request.auth.uid;
      }

      match /players/{uid} {
        allow read: if isMember(rid);
        allow create: if verified() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name','ready','has','score','hp','combo','prog','acc','upd','fin','joined','ph','fl','team','mods'])
          && request.resource.data.name == myName()
          && (roomOf(rid).hostUid == request.auth.uid || roomOf(rid).state == 'lobby')
          && (!roomOf(rid).priv || request.resource.data.get('ph', '') == get(/databases/$(db)/documents/rooms/$(rid)/secret/pw).data.h);
        allow update: if verified() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready','has','score','hp','combo','prog','acc','upd','fin','fl','team','mods'])
          && request.resource.data.get('mods', []).hasOnly(['EZ','HT','HR','HD','DT','FL','NF','SD','PF','SO'])
          && request.resource.data.get('mods', []).size() <= 6
          && request.resource.data.get('team', 'A') in ['', 'A', 'B']
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2000000000
          && request.resource.data.hp is number && request.resource.data.hp >= 0 && request.resource.data.hp <= 1
          && request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 1;
        allow delete: if verified() && (request.auth.uid == uid || roomOf(rid).hostUid == request.auth.uid);
      }

      // Hàng đợi bài: Host Only -> chỉ host thêm; All Players -> mọi thành viên thêm
      match /queue/{id} {
        allow read: if isMember(rid);
        allow create: if isMember(rid)
          && request.resource.data.keys().hasOnly(['hash','title','artist','ver','sr','len','mode','by','byName','t'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName == myName()
          && (roomOf(rid).hostUid == request.auth.uid || roomOf(rid).get('qm', 'host') == 'all');
        allow delete: if isMember(rid) && (roomOf(rid).hostUid == request.auth.uid || resource.data.by == request.auth.uid);
        allow update: if false;
      }

      match /chat/{id} {
        allow read: if isMember(rid);
        allow create: if isMember(rid)
          && request.resource.data.keys().hasOnly(['uid','name','text','t'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == myName()
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200;
        allow update, delete: if false;
      }
    }
  }
}
